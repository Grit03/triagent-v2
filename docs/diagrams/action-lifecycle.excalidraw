    {
      "id": "KcAdOZUgGvA0ZB2higySK",
      "type": "text",
      "x": 400.5425567626953,
      "y": 401.875,
      "width": 258.9148864746094,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
